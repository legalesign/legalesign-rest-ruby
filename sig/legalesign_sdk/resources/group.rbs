module LegalesignSDK
  module Resources
    class Group
      def create: (
        name: String,
        ?xframe_allow: bool,
        ?request_options: LegalesignSDK::request_opts
      ) -> nil

      def retrieve: (
        String group_id,
        ?request_options: LegalesignSDK::request_opts
      ) -> LegalesignSDK::Models::GroupRetrieveResponse

      def list: (
        ?limit: Integer,
        ?offset: Integer,
        ?request_options: LegalesignSDK::request_opts
      ) -> LegalesignSDK::Models::GroupListResponse

      def initialize: (client: LegalesignSDK::Client) -> void
    end
  end
end
