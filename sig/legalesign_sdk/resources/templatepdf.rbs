module LegalesignSDK
  module Resources
    class Templatepdf
      attr_reader fields: LegalesignSDK::Resources::Templatepdf::Fields

      def create: (
        group: String,
        pdf_file: String,
        ?archive_upon_send: bool,
        ?process_tags: bool,
        ?title: String,
        ?user: String,
        ?request_options: LegalesignSDK::request_opts
      ) -> nil

      def retrieve: (
        String pdf_id,
        ?request_options: LegalesignSDK::request_opts
      ) -> LegalesignSDK::TemplatePdf

      def list: (
        ?archive: String,
        ?group: String,
        ?limit: Integer,
        ?offset: Integer,
        ?request_options: LegalesignSDK::request_opts
      ) -> LegalesignSDK::Models::TemplatepdfListResponse

      def get_edit_link: (
        String pdf_id,
        ?request_options: LegalesignSDK::request_opts
      ) -> String

      def initialize: (client: LegalesignSDK::Client) -> void
    end
  end
end
